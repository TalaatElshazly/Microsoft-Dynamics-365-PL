{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "write_file|edit_file|write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "python -X utf8 ../book/tools/hook_pre_tool.py"
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "python -X utf8 ../book/tools/hook_stop.py"
      }
    ]
  }
}
